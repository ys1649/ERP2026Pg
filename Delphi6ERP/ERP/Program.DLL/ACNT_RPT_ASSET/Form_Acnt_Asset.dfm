  object qryReport: TADOQuery
    CursorType = ctStatic
    ParamCheck = False
    Parameters = <>
    SQL.Strings = (
      
        '--==============================================================' +
        '======='
      '--'#9#9'1.'#9#22522#28310#26085'='#26781#20214#26085'=12/31/2003'
      '--'#9#9'2. '#39'01/01/2004'#39#9'= '#22522#28310#26085' + 1'#22825
      '--'#9#9'3. '#39'01/01/2003'#39#9'= '#22522#28310#26085#24180#21021
      
        '--==============================================================' +
        '======='
      ''
      
        '--======================== '#36039#29986' ==================================' +
        '============'
      
        'SELECT '#39#36039#29986#39' GRP,A.TYP_MAJOR_TYPE,A.TYP_NO,TYP_NAME,A.ACT_NO,A.AC' +
        'T_NAME,A.AMOUNT'
      #9#9#9',(A.AMOUNT/10000.123)*100 RATE'
      'FROM'
      
        '('#9'SELECT D.TYP_MAJOR_TYPE,D.TYP_NO,D.TYP_NAME,SUBSTRING(C.ACT_NO' +
        ',1,4) ACT_NO,C.ACT_NAME'
      #9#9#9',SUM(A.JND_AMOUNT) AMOUNT'
      #9'FROM'
      #9'('#9'SELECT B.JNL_NO,B.JND_SEQNO,B.ACT_NO,B.JND_AMOUNT'
      #9#9'FROM TBL_ACNT_JOURNAL A'
      #9#9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9'WHERE A.JNL_DATE < '#39'01/01/2004'#39#9#9#9'--='#22522#28310#26085' + 1'#22825
      #9#9#9'AND A.JNL_DATE >= '#39'01/01/2003'#39#9#9'--='#22522#28310#26085#24180#21021
      #9') A'
      #9'INNER JOIN TBL_ACNT_ACCOUNT C ON A.ACT_NO=C.ACT_NO'
      #9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9'WHERE D.TYP_MAJOR_TYPE ='#39#36039#29986#39
      
        #9'GROUP BY D.TYP_MAJOR_TYPE,D.TYP_NO,D.TYP_NAME,SUBSTRING(C.ACT_N' +
        'O,1,4),C.ACT_NAME'
      #9'HAVING SUM(A.JND_AMOUNT)<>0'
      ') A'
      ''
      'UNION'
      ''
      
        '--======================== '#36000#20661' ==================================' +
        '============'
      
        'SELECT  '#39#36000#20661#21450#26989#20027#27402#30410#39' GRP,A.TYP_MAJOR_TYPE,A.TYP_NO,TYP_NAME,A.ACT_N' +
        'O,A.ACT_NAME,A.AMOUNT*-1'
      #9#9#9',(A.AMOUNT/20000.123)*100 RATE'
      'FROM'
      
        '('#9'SELECT D.TYP_MAJOR_TYPE,D.TYP_NO,D.TYP_NAME,SUBSTRING(C.ACT_NO' +
        ',1,4) ACT_NO,C.ACT_NAME'
      #9#9#9',SUM(A.JND_AMOUNT) AMOUNT'
      #9'FROM'
      #9'('#9'SELECT B.JNL_NO,B.JND_SEQNO,B.ACT_NO,B.JND_AMOUNT'
      #9#9'FROM TBL_ACNT_JOURNAL A'
      #9#9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9'WHERE A.JNL_DATE < '#39'01/01/2004'#39
      #9#9#9'AND A.JNL_DATE >= '#39'01/01/2003'#39
      #9') A'
      #9'INNER JOIN TBL_ACNT_ACCOUNT C ON A.ACT_NO=C.ACT_NO'
      #9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9'WHERE D.TYP_MAJOR_TYPE ='#39#36000#20661#39
      
        #9'GROUP BY D.TYP_MAJOR_TYPE,D.TYP_NO,D.TYP_NAME,SUBSTRING(C.ACT_N' +
        'O,1,4),C.ACT_NAME'
      #9'HAVING SUM(A.JND_AMOUNT)<>0'
      ') A'
      'UNION'
      
        '--======================== '#26989#20027#27402#30410' ================================' +
        '=============='
      
        'SELECT '#39#36000#20661#21450#26989#20027#27402#30410#39' GRP,A.TYP_MAJOR_TYPE,A.TYP_NO,TYP_NAME,A.ACT_NO' +
        ',A.ACT_NAME,A.AMOUNT*-1'
      #9#9#9',(A.AMOUNT/30000.123)*100 RATE'
      'FROM'
      
        '('#9'SELECT D.TYP_MAJOR_TYPE,D.TYP_NO,D.TYP_NAME,SUBSTRING(C.ACT_NO' +
        ',1,4) ACT_NO,C.ACT_NAME'
      #9#9#9',SUM(A.JND_AMOUNT) AMOUNT'
      #9'FROM'
      #9'('#9'SELECT B.JNL_NO,B.JND_SEQNO,B.ACT_NO,B.JND_AMOUNT'
      #9#9'FROM TBL_ACNT_JOURNAL A'
      #9#9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9'WHERE A.JNL_DATE < '#39'01/01/2004'#39
      #9#9#9'AND A.JNL_DATE >= '#39'01/01/2003'#39
      #9#9'UNION'
      #9#9'SELECT '#39'PROFIT'#39',-1,'#39'3353'#39' ACT_NO'
      #9#9#9#9#9',ISNULL(SUM(B.JND_AMOUNT),0)  AMOUNT'
      #9#9'FROM TBL_ACNT_JOURNAL A'
      #9#9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9#9'INNER JOIN TBL_ACNT_ACCOUNT C ON B.ACT_NO=C.ACT_NO'
      #9#9#9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9#9'WHERE A.JNL_DATE < '#39'01/01/2004'#39
      #9#9#9'AND A.JNL_DATE >= '#39'01/01/2003'#39
      #9#9#9'AND D.TYP_MAJOR_TYPE NOT IN ('#39#36039#29986#39','#39#36000#20661#39','#39#26989#20027#27402#30410#39')'
      #9') A'
      #9'INNER JOIN TBL_ACNT_ACCOUNT C ON A.ACT_NO=C.ACT_NO'
      #9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9'WHERE D.TYP_MAJOR_TYPE ='#39#26989#20027#27402#30410#39
      
        #9'GROUP BY D.TYP_MAJOR_TYPE,D.TYP_NO,D.TYP_NAME,SUBSTRING(C.ACT_N' +
        'O,1,4),C.ACT_NAME'
      #9'HAVING SUM(A.JND_AMOUNT)<>0'
      ') A'
      'ORDER BY TYP_NO,ACT_NO'
      ' '
      ' ')
    Left = 40
    Top = 64
  end
