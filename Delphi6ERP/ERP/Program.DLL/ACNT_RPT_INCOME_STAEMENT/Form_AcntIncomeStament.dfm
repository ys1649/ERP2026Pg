  object qry: TADOQuery
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'YEAR'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'SELECT * FROM TBL_JOURNAL '
      'WHERE YEAR(JNL_DATE)=:YEAR')
    Left = 228
    Top = 4
  end
  object qry_income: TADOQuery
    CursorType = ctStatic
    ParamCheck = False
    Parameters = <>
    SQL.Strings = (
      'SELECT 1 SN,A.TYP_MAJOR_TYPE,A.ACT_NAME,A.ACT_NO,A.SubTotal'
      #9#9#9',RATE='#9'CASE B.AMOUNT'
      #9#9#9#9#9#9#9'WHEN '#9'0 THEN 0'
      #9#9#9#9#9#9#9'ELSE (A.SubTotal/b.amount)*100 '
      #9#9#9#9#9#9#9'END'
      #9#9#9',S.SPR_COR_NAME'
      'FROM'
      '('#9'SELECT D.TYP_MAJOR_TYPE,C.ACT_NAME,C.ACT_NO'
      #9#9#9#9',SUM(B.JND_AMOUNT) * -1 SubTotal'
      #9'FROM TBL_ACNT_JOURNAL A'
      #9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9'INNER JOIN TBL_ACNT_ACCOUNT C ON B.ACT_NO=C.ACT_NO'
      #9#9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9'WHERE D.TYP_MAJOR_TYPE ='#39#29151#26989#25910#20837#39
      #9#9'and year(A.JNL_DATE)=2003'
      #9'GROUP BY  D.TYP_MAJOR_TYPE,C.ACT_NAME,C.ACT_NO'
      ') A,'
      '('#9'SELECT D.TYP_MAJOR_TYPE'
      #9#9#9#9',SUM(B.JND_AMOUNT) * -1 AMOUNT'
      #9'FROM TBL_ACNT_JOURNAL A'
      #9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9'INNER JOIN TBL_ACNT_ACCOUNT C ON B.ACT_NO=C.ACT_NO'
      #9#9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9'WHERE D.TYP_MAJOR_TYPE ='#39#29151#26989#25910#20837#39
      #9#9'and year(A.JNL_DATE)=2003'
      #9'GROUP BY  D.TYP_MAJOR_TYPE'
      ') B'
      ',TBL_SYS_PARAM S'
      ''
      'union'
      'SELECT 2 SN,A.TYP_MAJOR_TYPE,A.ACT_NAME,A.ACT_NO,A.SubTotal'
      #9#9#9',RATE='#9'CASE B.AMOUNT'
      #9#9#9#9#9#9#9'WHEN '#9'0 THEN 0'
      #9#9#9#9#9#9#9'ELSE (A.SubTotal/b.amount)*100 '
      #9#9#9#9#9#9#9'END'
      #9#9#9',S.SPR_COR_NAME'
      'FROM'
      '('#9'SELECT D.TYP_MAJOR_TYPE,C.ACT_NAME,C.ACT_NO'
      #9#9#9#9',SUM(B.JND_AMOUNT) SubTotal'
      #9'FROM TBL_ACNT_JOURNAL A'
      #9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9'INNER JOIN TBL_ACNT_ACCOUNT C ON B.ACT_NO=C.ACT_NO'
      #9#9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9'WHERE D.TYP_MAJOR_TYPE ='#39#29151#26989#25104#26412#39
      #9#9'and year(A.JNL_DATE)=2003'
      #9'GROUP BY  D.TYP_MAJOR_TYPE,C.ACT_NAME,C.ACT_NO'
      ') A,'
      '('#9'SELECT D.TYP_MAJOR_TYPE'
      #9#9#9#9',SUM(B.JND_AMOUNT) AMOUNT'
      #9'FROM TBL_ACNT_JOURNAL A'
      #9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9'INNER JOIN TBL_ACNT_ACCOUNT C ON B.ACT_NO=C.ACT_NO'
      #9#9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9'WHERE D.TYP_MAJOR_TYPE ='#39#29151#26989#25104#26412#39
      #9#9'and year(A.JNL_DATE)=2003'
      #9'GROUP BY  D.TYP_MAJOR_TYPE'
      ') B'
      ',TBL_SYS_PARAM S'
      ''
      'UNION'
      'SELECT 3 SN,A.TYP_MAJOR_TYPE,A.ACT_NAME,A.ACT_NO,A.SubTotal'
      #9#9#9',RATE='#9'CASE B.AMOUNT'
      #9#9#9#9#9#9#9'WHEN '#9'0 THEN 0'
      #9#9#9#9#9#9#9'ELSE (A.SubTotal/b.amount)*100 '
      #9#9#9#9#9#9#9'END'
      #9#9#9',S.SPR_COR_NAME'
      'FROM'
      '('#9'SELECT D.TYP_MAJOR_TYPE,C.ACT_NAME,C.ACT_NO'
      #9#9#9#9',SUM(B.JND_AMOUNT) SubTotal'
      #9'FROM TBL_ACNT_JOURNAL A'
      #9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9'INNER JOIN TBL_ACNT_ACCOUNT C ON B.ACT_NO=C.ACT_NO'
      #9#9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9'WHERE D.TYP_MAJOR_TYPE ='#39#29151#26989#36027#29992#39
      #9#9'and year(A.JNL_DATE)=2003'
      #9'GROUP BY  D.TYP_MAJOR_TYPE,C.ACT_NAME,C.ACT_NO'
      ') A,'
      '('#9'SELECT D.TYP_MAJOR_TYPE'
      #9#9#9#9',SUM(B.JND_AMOUNT) AMOUNT'
      #9'FROM TBL_ACNT_JOURNAL A'
      #9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9'INNER JOIN TBL_ACNT_ACCOUNT C ON B.ACT_NO=C.ACT_NO'
      #9#9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9'WHERE D.TYP_MAJOR_TYPE ='#39#29151#26989#36027#29992#39
      #9#9'and year(A.JNL_DATE)=2003'
      #9'GROUP BY  D.TYP_MAJOR_TYPE'
      ') B'
      ',TBL_SYS_PARAM S'
      ''
      'UNION'
      'SELECT 4 SN,A.TYP_MAJOR_TYPE,A.ACT_NAME,A.ACT_NO,A.SubTotal'
      #9#9#9',RATE='#9'CASE B.AMOUNT'
      #9#9#9#9#9#9#9'WHEN '#9'0 THEN 0'
      #9#9#9#9#9#9#9'ELSE (A.SubTotal/b.amount)*100 '
      #9#9#9#9#9#9#9'END'
      #9#9#9',S.SPR_COR_NAME'
      'FROM'
      '('#9'SELECT D.TYP_MAJOR_TYPE,C.ACT_NAME,C.ACT_NO'
      #9#9#9#9',SUM(B.JND_AMOUNT) * -1 SubTotal'
      #9'FROM TBL_ACNT_JOURNAL A'
      #9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9'INNER JOIN TBL_ACNT_ACCOUNT C ON B.ACT_NO=C.ACT_NO'
      #9#9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9'WHERE D.TYP_MAJOR_TYPE ='#39#29151#26989#22806#25910#20837#21450#36027#29992#39
      #9#9'and year(A.JNL_DATE)=2003'
      #9'GROUP BY  D.TYP_MAJOR_TYPE,C.ACT_NAME,C.ACT_NO'
      ') A,'
      '('#9'SELECT D.TYP_MAJOR_TYPE'
      #9#9#9#9',SUM(B.JND_AMOUNT) * -1 AMOUNT'
      #9'FROM TBL_ACNT_JOURNAL A'
      #9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9'INNER JOIN TBL_ACNT_ACCOUNT C ON B.ACT_NO=C.ACT_NO'
      #9#9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9'WHERE D.TYP_MAJOR_TYPE ='#39#29151#26989#22806#25910#20837#21450#36027#29992#39
      #9#9'and year(A.JNL_DATE)=2003'
      #9'GROUP BY  D.TYP_MAJOR_TYPE'
      ') B'
      ',TBL_SYS_PARAM S'
      ''
      'UNION'
      'SELECT 5 SN,A.TYP_MAJOR_TYPE,A.ACT_NAME,A.ACT_NO,A.SubTotal'
      #9#9#9',RATE='#9'CASE B.AMOUNT'
      #9#9#9#9#9#9#9'WHEN '#9'0 THEN 0'
      #9#9#9#9#9#9#9'ELSE (A.SubTotal/b.amount)*100 '
      #9#9#9#9#9#9#9'END'
      #9#9#9',S.SPR_COR_NAME'
      'FROM'
      '('#9'SELECT D.TYP_MAJOR_TYPE,C.ACT_NAME,C.ACT_NO'
      #9#9#9#9',SUM(B.JND_AMOUNT) SubTotal'
      #9'FROM TBL_ACNT_JOURNAL A'
      #9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9'INNER JOIN TBL_ACNT_ACCOUNT C ON B.ACT_NO=C.ACT_NO'
      #9#9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9'WHERE D.TYP_MAJOR_TYPE ='#39#25152#24471#31237#36027#29992'('#25110#21033#30410')'#39
      #9#9'and year(A.JNL_DATE)=2003'
      #9'GROUP BY  D.TYP_MAJOR_TYPE,C.ACT_NAME,C.ACT_NO'
      ') A,'
      '('#9'SELECT D.TYP_MAJOR_TYPE'
      #9#9#9#9',SUM(B.JND_AMOUNT) AMOUNT'
      #9'FROM TBL_ACNT_JOURNAL A'
      #9#9'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      #9#9'INNER JOIN TBL_ACNT_ACCOUNT C ON B.ACT_NO=C.ACT_NO'
      #9#9'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      #9'WHERE D.TYP_MAJOR_TYPE ='#39#25152#24471#31237#36027#29992'('#25110#21033#30410')'#39
      #9#9'and year(A.JNL_DATE)=2003'
      #9'GROUP BY  D.TYP_MAJOR_TYPE'
      ') B'
      ',TBL_SYS_PARAM S'
      ''
      'ORDER BY SN,ACT_NO')
    Left = 152
    Top = 4
  end
