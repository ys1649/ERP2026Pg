  object qryReport: TADOQuery
    CursorType = ctStatic
    ParamCheck = False
    Parameters = <>
    SQL.Strings = (
      'SELECT D.TYP_MAJOR_TYPE,D.TYP_NO,D.TYP_NAME,B.ACT_NO,C.ACT_NAME'
      #9#9#9',SUM(B.JND_AMOUNT) BALANCE'
      'FROM TBL_ACNT_JOURNAL A'
      'INNER JOIN TBL_ACNT_JOURNAL_DT B ON A.JNL_NO=B.JNL_NO'
      'INNER JOIN TBL_ACNT_ACCOUNT C ON B.ACT_NO=C.ACT_NO'
      'INNER JOIN TBL_ACNT_TYPE D ON C.TYP_NO=D.TYP_NO'
      'WHERE A.JNL_BILL_TYPE <> 2 '
      #9'AND A.JNL_DATE < CONVERT(DATETIME,'#39'01-01-2007'#39',20)'
      
        'GROUP BY  D.TYP_MAJOR_TYPE,D.TYP_NO,D.TYP_NAME,B.ACT_NO,C.ACT_NA' +
        'ME'
      'ORDER BY D.TYP_NO,B.ACT_NO'
      '')
    Left = 24
    Top = 52
  end
  object dsReport: TDataSource
    DataSet = qryReport
    Left = 92
    Top = 52
  end
