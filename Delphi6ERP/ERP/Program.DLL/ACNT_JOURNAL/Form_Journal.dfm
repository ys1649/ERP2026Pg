  object qry_Mast: TADOQuery
    Parameters = <>
    SQL.Strings = (
      'SELECT * FROM TBL_ACNT_JOURNAL')
    Left = 84
    Top = 116
  end
  object qry_dt: TADOQuery
    Parameters = <>
    SQL.Strings = (
      'SELECT JNL_NO,JND_SEQNO,ACT_NO'
      #9#9#9',CASE WHEN JND_AMOUNT >= 0 THEN 1'#9'ELSE -1'#9'END AS JND_DC'
      #9#9#9', JND_AMOUNT,JND_DESC'
      'FROM TBL_ACNT_JOURNAL_DT '
      'WHERE JNL_NO='#39'A10839'#39)
    Left = 84
    Top = 168
  end
