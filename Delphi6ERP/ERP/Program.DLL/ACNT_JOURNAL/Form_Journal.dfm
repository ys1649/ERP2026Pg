  object qryReport: TADOQuery
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      'SELECT M.JNL_DATE,M.JNL_NO,M.JNL_DESC'
      #9#9#9',D.ACT_NO'
      #9#9#9',DEBIT=CASE'
      #9#9#9#9'WHEN D.JND_AMOUNT>=0 THEN D.JND_AMOUNT'
      #9#9#9#9'ELSE 0'
      #9#9#9'END'
      #9#9#9',CREDIT=CASE'
      #9#9#9#9'WHEN D.JND_AMOUNT<0 THEN D.JND_AMOUNT * -1'
      #9#9#9#9'ELSE 0'
      #9#9#9'END'
      #9#9#9',D.JND_DESC'
      #9#9',C.ACT_NAME'
      'FROM TBL_ACNT_JOURNAL M'
      'INNER JOIN TBL_ACNT_JOURNAL_DT D ON M.JNL_NO=D.JNL_NO'
      'INNER JOIN TBL_ACNT_ACCOUNT C ON D.ACT_NO=C.ACT_NO')
    Left = 368
    Top = 240
  end
