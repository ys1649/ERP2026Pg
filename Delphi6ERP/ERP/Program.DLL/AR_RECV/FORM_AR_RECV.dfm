  object Qry_DT: TADOQuery
    Parameters = <>
    SQL.Strings = (
      'SELECT A.*,B.SMT_DATE,B.SMT_INV_NO'
      ',B.SMT_TOTAL+B.SMT_TAX SMT_AMOUNT,B.SMT_NOT_CLEAN'
      ' FROM TBL_AR_RECV_DT A'
      ' INNER JOIN TBL_SHIP B ON (A.SMT_NO=B.SMT_NO)'
      'WHERE ARR_NO='#39'1'#39)
    Left = 520
    Top = 252
  end
