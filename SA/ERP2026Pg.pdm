<a:ObjectID>20333883-8365-4E78-B76F-5878F325C634</a:ObjectID>
<a:Name>資料字典欄位定義</a:Name>
<a:Code>TBL_DDFIELD</a:Code>
<a:CreationDate>1788232733</a:CreationDate>
<a:Creator>mars16.wu</a:Creator>
<a:ModificationDate>1788232733</a:ModificationDate>
<a:Modifier>mars16.wu</a:Modifier>
<a:Comment>資料字典欄位定義</a:Comment>
<a:EndScript>
insert into TBLDD (DDM_NO, DDM_NAME, DDM_SQL, IS_MULTI_SELECTED, RET_VAL_FIELD)
values (&#39;TBLDD&#39;, &#39;資料字典&#39;, &#39;SELECT A.DDM_NO,A.DDM_NAME
FROM TBLDD A
ORDER BY A.DDM_NO&#39;, &#39;N         &#39;, &#39;DDM_NO&#39;);



insert into TBL_DDFIELD (DDD_ID, DDM_NO, DDD_FIELD, DDD_FIELD_DISP)
values (2, &#39;TBLDD&#39;, &#39;DDM_NAME&#39;, &#39;資料字典名稱&#39;);

insert into TBL_DDFIELD (DDD_ID, DDM_NO, DDD_FIELD, DDD_FIELD_DISP)
values (1, &#39;TBLDD&#39;, &#39;DDM_NO&#39;, &#39;資料字典編號&#39;);

COMMIT;
</a:EndScript>
